!=partial('includes/head/preconnect', {}, {cache: true})

//- LCP 预加载：首页顶图经由 CSS background 加载，浏览器无法提前发现，首页单独预加载
if is_home() && theme.index_img
  - var _lcpMatch = theme.index_img.match(/url\(([^)]+)\)/)
  if _lcpMatch
    link(rel="preload" as="image" href=_lcpMatch[1].replace(/['"]/g, '') fetchpriority="high")

//- 本地图标字体预加载（与 ali_iconfont_css.css 中的相对路径对应），减少图标闪烁
link(rel="preload" as="font" type="font/woff2" crossorigin href=url_for('/font-local/anzhiyu/font_2508400_fpn9ui60u6q.woff2'))

