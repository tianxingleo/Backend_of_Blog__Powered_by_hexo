{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node tools/ai/cli.js generate && node --max-old-space-size=12288 ./node_modules/hexo/bin/hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "algolia": "node -r dotenv/config ./node_modules/hexo/bin/hexo algolia",
    "ai:plan": "node tools/ai/cli.js plan",
    "ai:generate": "node tools/ai/cli.js generate",
    "d": "hexo clean && node tools/ai/cli.js generate && node --max-old-space-size=12288 ./node_modules/hexo/bin/hexo generate && hexo deploy && npm run algolia && git add . && git commit -m \"Daily update\" && git push"
  },
  "hexo": {
    "version": "8.1.1"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "hexo": "^8.1.1",
    "hexo-algoliasearch": "^2.0.1",
    "hexo-all-minifier": "^0.5.7",
    "hexo-deployer-git": "^4.0.0",
    "hexo-filter-katex": "^1.1.0",
    "hexo-generator-alias": "^1.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-markdown-it-plus": "^1.0.6",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0"
  }
}
