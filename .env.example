# ===== 构建期 AI 摘要生成配置模板 =====
# 复制为 .env 后填入真实密钥：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交；密钥只存在于本地构建进程，不进入静态页面。

# --- 提供方顺序（逗号分隔，依次回退） ---
# opencode  = 主通道，使用 opencode go 额度
# deepseek  = 回退通道，DeepSeek 官网 API
AI_PROVIDER_ORDER=opencode,deepseek

# --- 主通道：opencode go ---
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
# opencode 网关要求携带 x-opencode-session 请求头（自定义会话名即可）
OPENCODE_SESSION=

# --- 回退通道：DeepSeek 官网 ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# --- 生成器行为 ---
AI_ENABLED=true
# 每次构建并发请求数，合理区间 2~5
AI_CONCURRENCY=5
# 单请求传输类错误（429/5xx/超时）的最大重试次数
AI_MAX_RETRIES=2
# 单请求超时（毫秒）
AI_REQUEST_TIMEOUT_MS=60000
# 送入模型的最大正文字符数，超出截断
AI_MAX_INPUT_CHARS=15000
AI_MAX_OUTPUT_TOKENS=1000
# 每次构建最大请求数 / 最大 token 数，触顶后停止派发新任务，下次构建续做
AI_MAX_REQUESTS_PER_BUILD=30
AI_MAX_TOKENS_PER_BUILD=100000

# --- 可选：每百万 token 单价（美元），填写后构建日志会估算费用 ---
AI_PRICE_PER_MTOK_INPUT=
AI_PRICE_PER_MTOK_OUTPUT=
